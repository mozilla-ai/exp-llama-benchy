# TAG qwen3.8:27b-lms
# Copied from `ollama show --modelfile qwen3.8:27b` MINUS
# `PARAMETER draft_num_predict 4` (= no MTP speculative decoding) and minus the
# mmproj FROM line (text benchmark; the other runtimes don't load it either).
FROM @LMS@/Qwen3.8-27B-GGUF/Qwen3.8-27B-Q4_K_M.gguf
TEMPLATE {{ .Prompt }}
RENDERER qwen3.8
PARSER qwen3.5
PARAMETER top_p 0.95
PARAMETER min_p 0
PARAMETER presence_penalty 0
PARAMETER repeat_penalty 1
PARAMETER temperature 1
PARAMETER top_k 20
